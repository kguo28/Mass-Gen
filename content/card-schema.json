{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kguo28/Mass-Gen/content/card-schema.json",
  "title": "Change Concept Card",
  "description": "Schema for a Living Field Guide Change Concept Card. Uses the Trigger → Actor → Action → Target → Timing grammar.",
  "type": "object",
  "required": [
    "card_id",
    "card_title",
    "condition_context",
    "primary_ccm_element",
    "workflow_core_activity",
    "tags",
    "evidence_maturity",
    "implementation_complexity",
    "status",
    "faculty_author",
    "owner_steward",
    "version",
    "last_updated",
    "grammar",
    "operational_definition",
    "measures"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "description": "Stable identifier. Format: [NETWORK]-[CCM]-[DOMAIN]-###.",
      "pattern": "^[A-Z]+-[A-Z]+-[A-Z]+-[0-9]{3}$"
    },
    "card_title": { "type": "string" },
    "condition_context": { "type": "string" },
    "primary_ccm_element": {
      "type": "string",
      "enum": [
        "Delivery System / Work Role Redesign",
        "Decision Support",
        "Clinical Information Systems & Population Management",
        "Self-Management Support / Co-Production",
        "Community Resources & Peer Supports",
        "Organizational Leadership & Learning System"
      ]
    },
    "workflow_core_activity": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Screening/diagnosis",
          "Routine monitoring",
          "Treatment optimization",
          "Follow-up/coordination",
          "Safety monitoring",
          "Recovery supports"
        ]
      },
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 3
    },
    "evidence_maturity": {
      "type": "string",
      "enum": [
        "Literature-supported",
        "Locally tested",
        "Network-validated",
        "Multi-network replicated"
      ]
    },
    "implementation_complexity": {
      "type": "string",
      "enum": ["Starter", "Standard", "Advanced"]
    },
    "status": {
      "type": "string",
      "enum": ["Draft", "In Review", "Published", "Deprecated"]
    },
    "faculty_author": {
      "type": "object",
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "owner_steward": {
      "type": "object",
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "version": { "type": "string" },
    "last_updated": { "type": "string", "format": "date" },
    "grammar": {
      "type": "object",
      "required": ["trigger", "actor", "action", "target", "timing"],
      "properties": {
        "trigger": {
          "type": "object",
          "required": ["description"],
          "properties": {
            "description": { "type": "string" },
            "trigger_type": {
              "type": "string",
              "enum": ["Scheduled event", "Clinical threshold", "Patient request", "Time-based", "Registry alert", "Other"]
            }
          }
        },
        "actor": {
          "type": "object",
          "required": ["primary_role"],
          "properties": {
            "primary_role": { "type": "string" },
            "supporting_roles": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "action": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step_number", "description"],
            "properties": {
              "step_number": { "type": "integer", "minimum": 1 },
              "description": { "type": "string" },
              "actor_role": { "type": "string" },
              "tool_or_asset": { "type": "string" }
            }
          },
          "minItems": 1
        },
        "target": {
          "type": "object",
          "required": ["description"],
          "properties": {
            "description": { "type": "string" },
            "eligibility_criteria": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "timing": {
          "type": "object",
          "required": ["description"],
          "properties": {
            "description": { "type": "string" },
            "frequency": {
              "type": "string",
              "enum": ["Per visit", "Daily", "Weekly", "Monthly", "As triggered", "Other"]
            },
            "advance_hours": { "type": "integer", "minimum": 0 },
            "follow_up_hours": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "operational_definition": {
      "type": "object",
      "required": ["summary", "fidelity_criteria"],
      "properties": {
        "summary": { "type": "string" },
        "fidelity_criteria": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "measures": {
      "type": "object",
      "required": ["process_measures"],
      "properties": {
        "process_measures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "numerator", "denominator"],
            "properties": {
              "name": { "type": "string" },
              "numerator": { "type": "string" },
              "denominator": { "type": "string" }
            }
          },
          "minItems": 1
        },
        "outcome_measures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "numerator": { "type": "string" },
              "denominator": { "type": "string" }
            }
          }
        },
        "balancing_measures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}